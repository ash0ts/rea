FROM node:24.22.1-bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends python3 python3-venv procps ripgrep ca-certificates \
    && rm -rf /var/lib/apt/lists/* \
    && python3 -m venv /opt/python \
    && /opt/python/bin/pip install --no-cache-dir pillow==13.0.0
ENV PATH="/opt/python/bin:${PATH}" PYTHONDONTWRITEBYTECODE=1
COPY execute.py /opt/recovery/execute.py
WORKDIR /work
CMD ["sleep", "infinity"]
